# Copy to .env.local and fill in. .env.local is gitignored.

# Ticket scanner (Anthropic). Required for /api/scan-ticket.
CLAUDE_API_KEY=sk-ant-...

# Lead + contact email (Resend). Required for /api/lead and /api/contact.
RESEND_API_KEY=re_...

# Analytics (optional — /api/track falls back to a public project)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Telegram alerts on conversions (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
